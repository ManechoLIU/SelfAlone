<view wx:if="{{open}}" class="drawer-layer {{keyboardOpen ? 'is-keyboard-open' : ''}}" style="{{viewportStyle}}" role="dialog" aria-label="主导航">
  <view class="drawer-mask" bindtap="close" aria-label="关闭主导航"></view>
  <view class="drawer-panel">
    <view class="drawer-brand">
      <image class="drawer-avatar" src="/assets/avatar/laoji-avatar.png" mode="aspectFill" aria-hidden="true"></image>
      <view class="drawer-name">老己</view>
      <button class="drawer-close" bindtap="close" aria-label="关闭主导航">
        <image class="drawer-close__icon" src="/assets/icons/close.svg" mode="aspectFit" aria-hidden="true"></image>
      </button>
    </view>

    <button class="drawer-new" data-target="conversation" bindtap="navigate" aria-label="新建对话，进入对话页">
      <image class="drawer-new__icon" src="/assets/icons/conversation.svg" mode="aspectFit" aria-hidden="true"></image>
      <text>新建对话</text>
    </button>

    <view class="drawer-search">
      <image class="drawer-search__icon" src="/assets/icons/search.svg" mode="aspectFit" aria-hidden="true"></image>
      <input class="drawer-search__input" value="{{query}}" bindinput="onSearch" adjust-position="{{false}}" cursor-spacing="12" placeholder="搜索会话" aria-label="搜索会话" />
    </view>

    <view class="drawer-section-title">最近会话</view>
    <scroll-view class="drawer-conversations" scroll-y="true" enhanced show-scrollbar="{{false}}">
      <view wx:if="{{drawerStatus === 'loading'}}" class="drawer-state drawer-state--loading" role="status" aria-live="polite">
        <view class="drawer-skeleton" aria-hidden="true"></view>
        <view class="drawer-skeleton drawer-skeleton--short" aria-hidden="true"></view>
        <text class="drawer-state__label">正在加载会话</text>
      </view>

      <view wx:elif="{{drawerStatus === 'empty'}}" class="drawer-state" role="status">
        <text class="drawer-state__title">还没有会话</text>
        <text class="drawer-state__copy">新建一个对话，稍后会出现在这里。</text>
      </view>

      <view wx:elif="{{drawerStatus === 'filtered-empty'}}" class="drawer-state" role="status">
        <text class="drawer-state__title">没有匹配的会话</text>
        <button class="drawer-state__action" bindtap="clearSearch" aria-label="清除搜索">清除搜索</button>
      </view>

      <view wx:elif="{{drawerStatus === 'failed'}}" class="drawer-state drawer-state--error" role="alert" aria-live="assertive">
        <text class="drawer-state__title">会话暂时无法加载</text>
        <text wx:if="{{errorMessage}}" class="drawer-state__copy">{{errorMessage}}</text>
        <button class="drawer-state__action" bindtap="retry" aria-label="重试加载会话">重试</button>
      </view>

      <view wx:if="{{drawerStatus === 'failed' || drawerStatus === 'normal'}}" class="drawer-conversation-list">
        <button
          wx:for="{{visibleConversations}}"
          wx:key="id"
          class="drawer-conversation {{item.current ? 'drawer-conversation--current' : ''}} {{item.disabled ? 'drawer-conversation--disabled' : ''}}"
          data-id="{{item.id}}"
          data-target="{{item.target || 'conversation'}}"
          bindtap="navigate"
          disabled="{{item.disabled}}"
          aria-current="{{item.current ? 'page' : 'false'}}"
          aria-label="打开{{item.title}}"
        >
          <view class="drawer-conversation__body">
            <view class="drawer-conversation__title">{{item.title}}</view>
            <view wx:if="{{item.preview}}" class="drawer-conversation__meta">{{item.preview}}</view>
          </view>
          <view class="drawer-conversation__trail">
            <text wx:if="{{item.current}}" class="drawer-conversation__state">当前会话</text>
            <text wx:elif="{{item.updatedLabel}}" class="drawer-conversation__updated">{{item.updatedLabel}}</text>
          </view>
        </button>
      </view>
    </scroll-view>

    <view class="drawer-scenery-slot" aria-hidden="true">
      <image class="drawer-scenery" src="/assets/backgrounds/mobile-drawer-landscape-transparent-cropped-v1-mirrored.png" mode="widthFix" aria-hidden="true"></image>
    </view>

    <view class="drawer-nav">
      <button class="drawer-nav__item {{current === 'library' ? 'is-current' : ''}}" data-target="library" bindtap="navigate" aria-label="读书">
        <image class="drawer-nav__icon" src="/assets/icons/book.svg" mode="aspectFit" aria-hidden="true"></image><text>读书</text>
        <image class="drawer-nav__arrow" src="/assets/icons/arrow.svg" mode="aspectFit" aria-hidden="true"></image>
      </button>
      <button class="drawer-nav__item {{current === 'settings' ? 'is-current' : ''}}" data-target="settings" bindtap="navigate" aria-label="设置">
        <image class="drawer-nav__icon" src="/assets/icons/settings.svg" mode="aspectFit" aria-hidden="true"></image><text>设置</text>
        <image class="drawer-nav__arrow" src="/assets/icons/arrow.svg" mode="aspectFit" aria-hidden="true"></image>
      </button>
    </view>
  </view>
</view>
