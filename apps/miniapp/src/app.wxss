page {
  --bg: #eaf1ec;
  --surface: #f8faf6;
  --surface-raised: #ffffff;
  --surface-subtle: #d4e5dc;
  --text-primary: #21312d;
  --text-secondary: #5f6f69;
  --border: #b8cbc3;
  --accent-strong: #174c3f;
  --accent: #0d6a57;
  --accent-mid: #3f8b75;
  --accent-soft: #d9eae3;
  --accent-faint: #eff5f2;
  --reader: #f5f7f2;
  --error: #b44432;
  min-height: 100%;
  background: var(--surface);
  color: var(--text-primary);
  font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
  font-size: 16px;
  line-height: 1.75;
  max-width: 100%;
  overflow-x: hidden;
}

button,
input,
textarea {
  font: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  width: 100%;
  max-width: 100%;
  min-height: var(--viewport-height, 100vh);
  box-sizing: border-box;
  overflow-x: hidden;
  padding: calc(var(--safe-top, env(safe-area-inset-top)) + 24px) 18px calc(var(--safe-bottom, env(safe-area-inset-bottom)) + 24px);
  background: var(--surface);
}

.app-header {
  min-height: 48px;
  display: grid;
  grid-template-columns: 48px 1fr 72px;
  align-items: center;
  gap: 8px;
}

.app-header__title {
  min-width: 0;
  text-align: center;
  font-size: 20px;
  line-height: 28px;
  font-weight: 600;
  color: var(--accent-strong);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.icon-button,
.text-icon-button {
  min-width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 12px;
  background: transparent;
  color: var(--accent-strong);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
}

.text-icon-button {
  font-size: 14px;
  font-weight: 500;
}

.icon-button:active,
.text-icon-button:active {
  background: var(--accent-soft);
}

.icon {
  width: 22px;
  height: 22px;
  flex: none;
}

.primary-button,
.secondary-button {
  width: 100%;
  min-height: 52px;
  margin: 0;
  padding: 0 20px;
  border-radius: 18px;
  font-size: 16px;
  font-weight: 600;
}

.primary-button {
  background: var(--accent);
  color: #fff;
}

.primary-button:active {
  background: #0a594a;
}

.primary-button[disabled] {
  background: #9dafaa;
  color: #eef3f0;
}

.secondary-button {
  border: 1px solid var(--border);
  background: transparent;
  color: var(--accent-strong);
}

.secondary-button:active {
  background: var(--accent-faint);
}

.development-boundary {
  margin: 12px 0 16px;
  padding: 9px 12px;
  border: 1px solid #c7d7d0;
  border-radius: 12px;
  background: #eff5f2;
  color: #51625c;
  font-size: 12px;
  line-height: 18px;
  overflow-wrap: break-word;
}

.inline-error,
.inline-notice {
  margin: 12px 0;
  padding: 10px 12px;
  border-radius: 12px;
  font-size: 14px;
  line-height: 22px;
}

.inline-error {
  border: 1px solid rgba(180, 68, 50, .3);
  background: #fbf1ee;
  color: #8f3527;
}

.inline-notice {
  border: 1px solid var(--border);
  background: var(--accent-faint);
  color: var(--text-secondary);
}

.state-panel {
  min-height: 360px;
  padding: 48px 24px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  text-align: center;
}

.state-panel__title {
  font-size: 18px;
  line-height: 26px;
  font-weight: 600;
  color: var(--accent-strong);
}

.state-panel__body {
  max-width: 280px;
  color: var(--text-secondary);
  font-size: 14px;
  line-height: 22px;
  overflow-wrap: break-word;
}

.state-panel__action {
  min-width: 132px;
  min-height: 44px;
  margin-top: 4px;
  padding: 0 18px;
  border-radius: 14px;
  background: var(--accent);
  color: #fff;
  font-size: 14px;
  font-weight: 600;
}

.loading-lines {
  width: 100%;
  max-width: 280px;
  display: grid;
  gap: 12px;
}

.loading-line {
  height: 14px;
  border-radius: 8px;
  background: var(--surface-subtle);
  opacity: .75;
}

.loading-line:nth-child(2) { width: 78%; }
.loading-line:nth-child(3) { width: 58%; }

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
