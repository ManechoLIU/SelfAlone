.sheet-state, .content-state { min-height: 230px; padding: 40px 20px; box-sizing: border-box; color: #68766f; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; text-align: center; font-size: 13px; }
.content-viewport { width: 100%; min-height: 0; flex: 1; margin-top: 12px; box-sizing: border-box; }
.content-notes-toolbar { min-height: 56px; padding: 8px 0 4px; box-sizing: border-box; border-bottom: 1px solid #e0e6e3; display: flex; align-items: center; justify-content: flex-end; }
.content-create-note { min-height: 44px; margin: 0; padding: 0 4px; border-radius: 10px; background: transparent; color: #0d6a57; font-size: 14px; line-height: 22px; }
.content-create-note:active, .content-create-note:focus { background: #eff5f2; }
.content-create-note[disabled] { opacity: .48; }
.content-inline-status, .content-inline-error { min-height: 40px; padding: 10px 0; box-sizing: border-box; border-bottom: 1px solid #e0e6e3; color: #68766f; display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 12px; line-height: 18px; }
.content-inline-error { color: #8f3527; }
.content-inline-error__retry { flex: none; min-width: 64px; min-height: 44px; margin: 0; padding: 0 8px; border: 1px solid #0d6a57; border-radius: 10px; background: transparent; color: #0d6a57; font-size: 13px; }
.content-inline-error__retry:active, .content-inline-error__retry:focus { background: #eff5f2; }
.content-row { padding: 18px 2px; border-bottom: 1px solid #e0e6e3; }
.content-quote { padding-left: 12px; border-left: 2px solid #8db9aa; color: #5f6f69; font-family: "Songti SC", "STSong", serif; font-size: 14px; line-height: 24px; }
.content-body { margin-top: 10px; font-size: 15px; line-height: 26px; overflow-wrap: break-word; }
.content-meta { margin-top: 8px; color: #87938e; font-size: 11px; line-height: 18px; }
.note-list { width: 100%; }
.note-row { padding: 18px 0; border-bottom: 1px solid #e0e6e3; }
.note-body-row { display: flex; align-items: flex-start; gap: 4px; }
.note-body-row .note-body { min-width: 0; flex: 1; margin-top: 0; }
.note-quote { padding-left: 12px; border-left: 2px solid #8db9aa; color: #5f6f69; font-family: "Songti SC", "STSong", serif; font-size: 14px; line-height: 24px; }
.note-body { margin-top: 10px; font-size: 15px; line-height: 26px; overflow-wrap: break-word; }
.note-meta { margin-top: 8px; color: #87938e; font-size: 11px; line-height: 18px; }
.note-more { flex: none; width: 44px; height: 44px; margin: -10px -8px 0 0; padding: 0; border-radius: 12px; background: transparent; display: flex; align-items: center; justify-content: center; }
.note-more image { width: 20px; height: 20px; }
.note-more:active, .note-more:focus { background: #eff5f2; }
.note-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px; }
.note-action { min-width: 64px; min-height: 44px; margin: 0; padding: 0 10px; border: 1px solid #cbd8d3; border-radius: 10px; background: transparent; color: #174c3f; font-size: 13px; }
.note-action:active, .note-action:focus { background: #eff5f2; }
.note-action--danger { border-color: rgba(180,68,50,.35); color: #b44432; }
.note-action[disabled] { opacity: .48; }
.note-row-error { margin-top: 8px; padding: 10px 12px; box-sizing: border-box; border: 1px solid rgba(180,68,50,.28); border-radius: 10px; background: #fbf1ee; color: #8f3527; display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 12px; line-height: 18px; }
.note-row-error__retry { flex: none; min-height: 44px; margin: -2px -8px -2px 0; padding: 0 8px; border: 1px solid #0d6a57; border-radius: 10px; background: transparent; color: #0d6a57; font-size: 13px; }
.note-row-error__retry:active, .note-row-error__retry:focus { background: #eff5f2; }
.works-grid { padding: 18px 0; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px 12px; }
.work-preview { aspect-ratio: 16/9; padding: 12px; box-sizing: border-box; border: 1px solid #bdd0c8; border-radius: 8px; background: #eff5f2; color: #174c3f; display: flex; align-items: center; justify-content: center; text-align: center; font-family: "Songti SC", "STSong", serif; font-size: 13px; }
.work-meta { min-height: 44px; margin-top: 2px; color: #68766f; display: flex; align-items: center; justify-content: space-between; font-size: 11px; }
.work-download { width: 44px; height: 44px; margin: 0 -10px 0 0; padding: 0; border-radius: 12px; background: transparent; display: flex; align-items: center; justify-content: center; }
.work-download:active { background: #eff5f2; }
.work-download image { width: 22px; height: 22px; }

.note-editor-layer { position: fixed; inset: 0; z-index: 70; overflow: hidden; pointer-events: auto; }
.note-editor-mask { position: absolute; inset: 0; background: rgba(23,43,37,.3); }
.note-editor-surface { position: absolute; left: 0; right: 0; top: var(--safe-top, env(safe-area-inset-top)); bottom: 0; box-sizing: border-box; padding: 8px 20px 0; border-radius: 28px 28px 0 0; background: #f5f7f2; color: #21312d; display: flex; flex-direction: column; }
.note-editor-header { min-height: 56px; display: grid; grid-template-columns: 44px minmax(0,1fr) 44px; align-items: center; gap: 8px; }
.note-editor-close { width: 44px; height: 44px; margin: 0; padding: 0; border-radius: 12px; background: transparent; }
.note-editor-close image { width: 22px; height: 22px; }
.note-editor-close:active, .note-editor-close:focus { background: #e3f0eb; }
.note-editor-title { min-width: 0; color: #174c3f; font-family: "Songti SC", "STSong", serif; font-size: 20px; line-height: 28px; font-weight: 600; text-align: center; }
.note-editor-header-spacer { width: 44px; height: 44px; }
.note-editor-body { min-height: 0; flex: 1; display: flex; flex-direction: column; }
.note-editor-error { margin-top: 8px; padding: 10px 12px; border: 1px solid rgba(180,68,50,.3); border-radius: 10px; background: #fbf1ee; color: #8f3527; font-size: 12px; line-height: 18px; }
.note-editor-input { width: 100%; min-height: 240px; flex: 1; margin: 18px 0 0; padding: 12px 0; box-sizing: border-box; border: 0; border-bottom: 1px solid #b8cbc3; border-radius: 0; background: transparent; color: inherit; font-family: "Songti SC", "STSong", serif; font-size: 18px; line-height: 32px; }
.note-editor-input:focus { border-bottom-color: #0d6a57; box-shadow: none; }
.note-editor-hint { margin-top: 10px; color: #78867f; font-size: 12px; line-height: 18px; }
.note-editor-actions { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 12px; padding: 12px 0 calc(var(--safe-bottom, env(safe-area-inset-bottom)) + 12px); }
.note-editor-action { min-height: 44px; margin: 0; padding: 0 16px; border-radius: 12px; font-size: 14px; }
.note-editor-action--secondary { border: 1px solid #b8cbc3; background: transparent; color: #174c3f; }
.note-editor-action--primary { background: #174c3f; color: #fff; }
.reader--dark .content-notes-toolbar { border-color: rgba(123,145,136,.55); }
.reader--dark .content-create-note { color: #9ed0bd; }
.reader--dark .content-create-note:active, .reader--dark .content-create-note:focus,
.reader--dark .note-more:active, .reader--dark .note-more:focus { background: #29312e; }
.reader--dark .note-editor-surface { background: #171b1a; color: #eef3ef; }
.reader--dark .note-editor-title { color: #eef3ef; }
.reader--dark .note-editor-close:active, .reader--dark .note-editor-close:focus { background: #29312e; }
.reader--dark .note-editor-input { border-color: #6d8178; }
.reader--dark .note-editor-input:focus { border-bottom-color: #9ed0bd; }
.reader--dark .note-editor-hint { color: #aebbb5; }
.reader--dark .note-editor-action--secondary { border-color: #6d8178; color: #eef3ef; }

@media (prefers-reduced-motion: reduce) {
  .reader-sheet { transition: opacity 140ms ease; transform: none; }
  .reader-sheet--dragging { transition: opacity 140ms ease; }
}
