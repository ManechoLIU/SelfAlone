.settings-page {
  background: #f6f6f4;
}

.settings-header { margin-bottom: 28px; }

.settings-group { margin-top: 22px; }
.settings-group--services { margin-top: 34px; }

.settings-group__title {
  margin: 0 2px 10px;
  color: #3f8b75;
  font-family: "Songti SC", "STSong", serif;
  font-size: 16px;
  line-height: 24px;
  font-weight: 600;
}

.settings-row {
  width: 100%;
  min-height: 70px;
  margin: 0;
  padding: 0 4px;
  border-bottom: 1px solid #d8dfdc;
  border-radius: 0;
  background: transparent;
  color: #21312d;
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr) auto 22px;
  gap: 12px;
  align-items: center;
  text-align: left;
}

.settings-row:active { background: #eff5f2; }
.settings-row__icon { width: 24px; height: 24px; }
.settings-row__label { min-width: 0; font-family: "Songti SC", "STSong", serif; font-size: 19px; line-height: 28px; font-weight: 600; overflow-wrap: break-word; }
.settings-row__status { min-width: 0; color: #68766f; font-size: 13px; line-height: 20px; text-align: right; overflow-wrap: break-word; }
.settings-row__arrow { width: 20px; height: 20px; opacity: .75; }

.settings-row--logout {
  margin-top: 26px;
  border-bottom: 0;
  grid-template-columns: 28px minmax(0, 1fr);
}

@media (min-width: 430px) {
  .settings-page { padding-left: 28px; padding-right: 28px; }
}

@media (max-width: 340px) {
  .settings-row { grid-template-columns: 26px minmax(0, 1fr) auto 20px; gap: 8px; }
  .settings-row__label { font-size: 17px; line-height: 26px; }
  .settings-row__status { font-size: 12px; }
}

@media (max-height: 600px) {
  .settings-page { padding-top: calc(var(--safe-top, env(safe-area-inset-top)) + 12px); }
  .settings-header { margin-bottom: 16px; }
  .settings-group { margin-top: 14px; }
  .settings-group--services { margin-top: 22px; }
  .settings-row { min-height: 58px; }
}
