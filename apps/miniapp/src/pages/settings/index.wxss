.settings-page {
  background: #f6f6f4;
}

.settings-header { margin-bottom: 28px; }

.settings-group { margin-top: 22px; }
.settings-group--services { margin-top: 34px; }

.settings-group__title {
  margin: 0 2px 10px;
  color: #3f8b75;
  font-family: "Songti SC", "STSong", serif;
  font-size: 16px;
  line-height: 24px;
  font-weight: 600;
}

.settings-row {
  width: 100%;
  min-height: 70px;
  margin: 0;
  padding: 0 4px;
  border-bottom: 1px solid #d8dfdc;
  border-radius: 0;
  background: transparent;
  color: #21312d;
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr) auto 22px;
  gap: 12px;
  align-items: center;
  text-align: left;
}

.settings-row:active { background: #eff5f2; }
.settings-row__icon { width: 24px; height: 24px; }
.settings-row__label { min-width: 0; font-family: "Songti SC", "STSong", serif; font-size: 19px; line-height: 28px; font-weight: 600; overflow-wrap: break-word; }
.settings-row__status { min-width: 0; color: #68766f; font-size: 13px; line-height: 20px; text-align: right; overflow-wrap: break-word; }
.settings-row__arrow { width: 20px; height: 20px; opacity: .75; }

.settings-row--logout {
  margin-top: 26px;
  border-bottom: 0;
  grid-template-columns: 28px minmax(0, 1fr);
}

.settings-weread {
  display: flex;
  flex-direction: column;
}

.settings-weread__header { margin-bottom: 28px; }

.weread-config__intro {
  color: var(--text-secondary);
  font-size: 14px;
  line-height: 22px;
}

.weread-config__current {
  margin-top: 12px;
  color: var(--text-secondary);
  font-size: 13px;
  line-height: 20px;
  overflow-wrap: break-word;
}

.weread-field { display: block; margin-top: 24px; }

.weread-field__label {
  display: block;
  color: #3f8b75;
  font-family: "Songti SC", "STSong", serif;
  font-size: 15px;
  line-height: 22px;
  font-weight: 600;
}

.weread-field__control {
  margin-top: 8px;
  padding: 0 4px 0 16px;
  min-height: 54px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--surface-raised);
  display: flex;
  align-items: center;
  gap: 8px;
}

.weread-field__input {
  flex: 1;
  min-width: 0;
  min-height: 52px;
  font-size: 16px;
  color: var(--text-primary);
}

.weread-field__placeholder { color: #9dafaa; }

.weread-field__toggle {
  flex: none;
  min-width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0 12px;
  border: 0;
  border-radius: 12px;
  background: transparent;
  color: var(--accent-mid);
  font-size: 14px;
  line-height: 44px;
}

.weread-field__toggle:active { background: var(--accent-faint); }

.weread-field__error {
  margin-top: 8px;
  color: var(--error);
  font-size: 13px;
  line-height: 20px;
  overflow-wrap: break-word;
}

.weread-config__hint {
  margin-top: 10px;
  color: #68766f;
  font-size: 13px;
  line-height: 20px;
}

.weread-actions {
  margin-top: auto;
  padding-top: 24px;
  display: grid;
  gap: 8px;
  justify-items: center;
}

.weread-disconnect {
  min-width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0 12px;
  border: 0;
  border-radius: 12px;
  background: transparent;
  color: #68766f;
  font-size: 14px;
  line-height: 44px;
}

.weread-disconnect:active { background: var(--accent-faint); }

@media (min-width: 430px) {
  .settings-page { padding-left: 28px; padding-right: 28px; }
}

@media (max-width: 340px) {
  .settings-row { grid-template-columns: 26px minmax(0, 1fr) auto 20px; gap: 8px; }
  .settings-row__label { font-size: 17px; line-height: 26px; }
  .settings-row__status { font-size: 12px; }
}

@media (max-height: 600px) {
  .settings-page { padding-top: calc(var(--safe-top, env(safe-area-inset-top)) + 12px); }
  .settings-header { margin-bottom: 16px; }
  .settings-group { margin-top: 14px; }
  .settings-group--services { margin-top: 22px; }
  .settings-row { min-height: 58px; }
}
