.library-page {
  background: #fafbf8;
}

.viewport-receipt { display: block; margin-top: 4px; color: #68766f; font-variant-numeric: tabular-nums; }

.library-load-notice { display: flex; align-items: center; gap: 10px; }
.library-load-notice__copy { min-width: 0; flex: 1; overflow-wrap: break-word; }
.library-load-notice__action { min-width: 64px; min-height: 44px; margin: 0; padding: 0 12px; border: 1px solid #9bb8ad; border-radius: 12px; background: transparent; color: #174c3f; font-size: 13px; font-weight: 600; }

.search-field {
  min-height: 52px;
  margin-top: 14px;
  padding: 0 16px;
  border: 1px solid #cbd8d3;
  border-radius: 18px;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 10px;
}

.search-field image { width: 22px; height: 22px; flex: none; opacity: .72; }
.search-field input { min-width: 0; flex: 1; height: 52px; color: #21312d; font-size: 15px; }

.weread-row {
  width: 100%;
  min-height: 58px;
  margin: 12px 0 0;
  padding: 8px 12px;
  border-radius: 12px;
  background: transparent;
  color: #174c3f;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
}

.weread-row:active { background: #eff5f2; }
.weread-row > image { width: 20px; height: 20px; opacity: .7; }
.weread-row__title { font-size: 14px; line-height: 20px; font-weight: 500; }
.weread-row__meta { margin-top: 2px; color: #6b7973; font-size: 12px; line-height: 18px; }

.library-skeleton,
.book-grid {
  margin-top: 22px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28px 18px;
}

.skeleton-card { min-width: 0; }
.skeleton-cover { aspect-ratio: 5 / 7; border-radius: 8px; background: #dce7e1; }
.skeleton-title { width: 70%; height: 14px; margin-top: 10px; border-radius: 7px; background: #dce7e1; }

.book-item {
  min-width: 0;
  margin: 0;
  padding: 0;
  border-radius: 8px;
  background: transparent;
  color: #21312d;
  text-align: left;
}

.book-item:active { opacity: .86; }

.book-cover {
  position: relative;
  aspect-ratio: 5 / 7;
  overflow: hidden;
  border: 1px solid rgba(23, 76, 63, .14);
  border-radius: 8px;
  background: #e8eee9;
  box-shadow: 0 5px 14px rgba(33, 49, 45, .08);
}

.book-cover > image { position: absolute; inset: 0; width: 100%; height: 100%; }

.book-cover__copy {
  position: absolute;
  inset: 15% 12% auto;
  z-index: 1;
  color: #173f35;
  text-align: center;
  text-shadow: 0 1px 0 rgba(255,255,255,.45);
}

.book-cover__title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 18px;
  line-height: 1.35;
  font-weight: 600;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.book-cover__author { margin-top: 8px; font-size: 11px; line-height: 17px; }

.book-progress {
  position: absolute;
  z-index: 2;
  inset: auto 8px 8px;
  min-height: 22px;
  padding: 0 7px;
  border-radius: 10px;
  background: rgba(20, 39, 34, .54);
  color: #fff;
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 11px;
  line-height: 16px;
}

.book-progress__track { min-width: 0; height: 3px; flex: 1; border-radius: 2px; background: rgba(255,255,255,.34); overflow: hidden; }
.book-progress__value { height: 100%; border-radius: 2px; background: #fff; }

.book-caption { margin-top: 8px; }
.book-caption__title { font-size: 15px; line-height: 22px; font-weight: 500; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.book-source { margin-top: 2px; color: #68766f; display: flex; align-items: center; gap: 4px; font-size: 11px; line-height: 18px; }
.book-source image { width: 14px; height: 14px; opacity: .65; }

@media (min-width: 430px) {
  .book-grid,
  .library-skeleton { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px 16px; }
  .book-cover__title { font-size: 15px; }
  .book-cover__author { font-size: 10px; }
}

@media (max-height: 600px) {
  .library-page { padding-top: calc(var(--safe-top, env(safe-area-inset-top)) + 12px); }
  .library-skeleton, .book-grid { margin-top: 14px; gap: 20px 14px; }
}
