<view class="page-shell library-page {{keyboardOpen ? 'is-keyboard-open' : ''}}" style="{{viewportStyle}}">
  <view class="app-header">
    <button class="icon-button" bindtap="toggleDrawer" aria-label="打开主导航">
      <image class="icon" src="/assets/icons/menu.svg" mode="aspectFit" aria-hidden="true"></image>
    </button>
    <view class="app-header__title">读书</view>
    <button class="text-icon-button" bindtap="showImportBoundary" aria-label="导入本地书籍">
      <image class="icon" src="/assets/icons/import.svg" mode="aspectFit" aria-hidden="true"></image>
      <text>导入</text>
    </button>
  </view>

  <view class="search-field">
    <image src="/assets/icons/search.svg" mode="aspectFit" aria-hidden="true"></image>
    <input value="{{query}}" bindinput="onSearch" adjust-position="{{false}}" cursor-spacing="12" placeholder="搜索书名或作者" aria-label="搜索书名或作者" />
  </view>

  <button class="weread-row" bindtap="showWeReadBoundary" aria-label="连接微信读书">
    <view>
      <view class="weread-row__title">连接微信读书</view>
      <view class="weread-row__meta">同步书籍与个人划线</view>
    </view>
    <image src="/assets/icons/arrow.svg" mode="aspectFit" aria-hidden="true"></image>
  </button>

  <view wx:if="{{developmentAdapter}}" class="development-boundary">开发适配器仅提供本次运行内存数据；真实书架、导入与跨端同步尚未接入。<text class="viewport-receipt">{{viewportMetrics}}</text></view>
  <view wx:if="{{notice}}" class="inline-notice library-load-notice" role="alert">
    <text class="library-load-notice__copy">{{notice}}，已保留当前书架。</text>
    <button class="library-load-notice__action" bindtap="retryBooks" aria-label="重新加载书架">重试</button>
  </view>

  <view wx:if="{{kind === 'loading'}}" class="library-skeleton" aria-label="书架加载中">
    <view class="skeleton-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
      <view class="skeleton-cover"></view><view class="skeleton-title"></view>
    </view>
  </view>

  <view wx:elif="{{kind === 'empty'}}" class="state-panel">
    <view class="state-panel__title">书架还是空的</view>
    <view class="state-panel__body">导入一本 EPUB、TXT 或 PDF，或连接微信读书。</view>
    <button class="state-panel__action" bindtap="showImportBoundary">导入本地书籍</button>
  </view>

  <view wx:elif="{{kind === 'filtered-empty'}}" class="state-panel">
    <view class="state-panel__title">没有匹配的书</view>
    <view class="state-panel__body">换个书名或作者试试，现有书籍不会被清空。</view>
    <button class="state-panel__action" bindtap="clearSearch">清除搜索</button>
  </view>

  <view wx:elif="{{kind === 'failed'}}" class="state-panel">
    <view class="state-panel__title">书架暂时无法加载</view>
    <view class="state-panel__body" role="alert">{{error}}</view>
    <button class="state-panel__action" bindtap="retryBooks">重试</button>
  </view>

  <view wx:else class="book-grid" aria-label="统一书架">
    <button class="book-item" wx:for="{{visibleBooks}}" wx:key="id" data-id="{{item.id}}" bindtap="openBook" aria-label="打开《{{item.title}}》，{{item.sourceLabel}}，已读 {{item.progressLabel}}">
      <view class="book-cover">
        <image src="{{item.coverAsset}}" mode="aspectFill" aria-hidden="true"></image>
        <view class="book-cover__copy">
          <view class="book-cover__title">{{item.title}}</view>
          <view class="book-cover__author">{{item.author || '作者未知'}}</view>
        </view>
        <view class="book-progress">
          <view class="book-progress__track"><view class="book-progress__value" style="width: {{item.progressLabel}}"></view></view>
          <text>{{item.progressLabel}}</text>
        </view>
      </view>
      <view class="book-caption">
        <text class="book-caption__title">{{item.title}}</text>
        <view class="book-source"><image src="/assets/icons/book.svg" mode="aspectFit" aria-hidden="true"></image><text>{{item.sourceLabel}}</text></view>
      </view>
    </button>
  </view>
</view>

<nav-drawer open="{{drawerOpen}}" current="library" viewport-style="{{viewportStyle}}" keyboard-open="{{keyboardOpen}}" bind:close="closeDrawer"></nav-drawer>
